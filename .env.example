# Copy to .env and fill in. Never commit .env.
CITA_DOCUMENT_TYPE=NIE        # NIE | DNI | PASAPORTE
CITA_DOCUMENT_NUMBER=X0000000T
CITA_FULL_NAME=NOMBRE APELLIDO

# Optional overrides
# CITA_PROVINCE=Alicante
# CITA_OFFICE=CNP Comisaría Provincial, C/ Isabel la Católica, 25, Alicante
# CITA_PROCEDURE=POLICIA-CARTA DE INVITACIÓN
# CITA_HEADLESS=false
# CITA_STEP_DELAY_MIN=4
# CITA_STEP_DELAY_MAX=8
# CITA_START_DELAY_MIN=60     # random wait before starting, seconds
# CITA_START_DELAY_MAX=300    # set to 0 for manual runs to start immediately

# Telegram reports (optional). Each recipient sends /start to the bot, then run
# `uv run cita-register` to save their chat ID to telegram_chats.json.
# CITA_TELEGRAM_BOT_TOKEN=123456:ABC...
# CITA_TELEGRAM_ALLOWED_USERNAMES=alice,bob
